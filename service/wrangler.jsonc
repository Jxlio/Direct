{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "direct-rendezvous",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "DIRECTORY", "class_name": "Directory" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Directory"] }]
}
